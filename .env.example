# Hosted deployment: configure.py generates /opt/marksix/shared/.env.
# python3 deploy/vps/configure.py --domain app.example.com --admin-domain admin.example.com
HOSTED_SHARED_ROOT=/opt/marksix/shared
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com
AUTHORITY_ADMIN_USERNAME=owner
AUTHORITY_ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
AUTHORITY_DB_PASSWORD=
PORTAL_DB_PASSWORD=
BACKUP_KEEP=14
